{
  "version": 1,
  "protectedPaths": [
    "policies/",
    ".github/",
    ".claude/",
    ".codex/",
    ".agents/",
    "AGENTS.md",
    "CLAUDE.md",
    ".env",
    ".tollgate/",
    ".claude-plugin/",
    ".mcp.json",
    ".codex/config.toml"
  ],
  "blockedCommands": [
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+push\\b.*(\\s--force(-with-lease|-if-includes)?\\b|\\s-[a-zA-Z]*f[a-zA-Z]*\\b|\\s\\+\\S)",
      "reason": "Force push is not allowed (including -f combinations and +refspec)."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+(reset\\b.*--hard|clean\\b.*\\s(?:-[a-zA-Z]*f|--force\\b)|stash\\b|checkout\\s+(--\\s+)?\\.(\\s|$))",
      "reason": "Destructive git operation requires a human."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+restore\\b(?=.*(--worktree\\b|\\s-[a-zA-Z]*W))",
      "reason": "Restoring the working tree discards changes; requires a human."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+restore\\b(?!.*(--staged\\b|\\s-[a-zA-Z]*S))",
      "reason": "Restoring the working tree discards changes; requires a human."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+(commit|push|merge|rebase)\\b.*--no-v(e(r(i(fy?)?)?)?)?\\b",
      "reason": "Git hooks must not be bypassed."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+commit\\b.*\\s-[a-zA-Z]*n[a-zA-Z]*(\\s|$)",
      "reason": "Git hooks must not be bypassed."
    },
    {
      "pattern": "(?:^|\\n)(?:(?!\\bgit\\b)[^\\n])*\\bgit\\b[^\\n]*?[cC][oO][rR][eE]\\.[hH][oO][oO][kK][sS][pP][aA][tT][hH]\\s*=",
      "reason": "Git hooks must not be disabled."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+config\\b(?:(?!\\s--(?:get|get-all|get-regexp|list|unset|unset-all)\\b).)*\\b[cC][oO][rR][eE]\\.[hH][oO][oO][kK][sS][pP][aA][tT][hH]\\s+\\S",
      "reason": "Git hooks must not be disabled."
    },
    {
      "pattern": "\\bGIT_CONFIG_(?:KEY_[0-9]+|PARAMETERS)\\b.*[cC][oO][rR][eE]\\.[hH][oO][oO][kK][sS][pP][aA][tT][hH]",
      "reason": "Git hooks must not be disabled."
    },
    {
      "pattern": "(?:^|\\n)(?:(?!\\bgit\\b)[^\\n])*\\bgit\\b[^\\n]*?[iI][nN][cC][lL][uU][dD][eE](?:[iI][fF]\\.\\S*)?\\.[pP][aA][tT][hH]\\s*=",
      "reason": "Git configuration includes (include.path) can disable hooks."
    },
    {
      "pattern": "\\bgit(?:\\s+(?:(?:-[cC]|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source))\\s+[^\\s-]\\S*|--?[\\w.][\\w.-]*(?:=\\S+)?))*\\s+config\\b(?:(?!\\s--(?:get|get-all|get-regexp|list|unset|unset-all)\\b).)*\\b[iI][nN][cC][lL][uU][dD][eE](?:[iI][fF]\\.\\S*)?\\.[pP][aA][tT][hH]\\s+\\S",
      "reason": "Git configuration includes (include.path) can disable hooks."
    },
    {
      "pattern": "\\bGIT_CONFIG_(?:KEY_[0-9]+|PARAMETERS)\\b.*[iI][nN][cC][lL][uU][dD][eE](?:[iI][fF]\\.\\S*)?\\.[pP][aA][tT][hH]",
      "reason": "Git configuration includes (include.path) can disable hooks."
    },
    {
      "pattern": "\\bGIT_CONFIG_(?:GLOBAL|SYSTEM|NOSYSTEM)\\b",
      "reason": "Redirecting git's global or system configuration is not allowed (it can disable hooks)."
    },
    {
      "pattern": "(?<![\\w${])GIT_(?:DIR|WORK_TREE|INDEX_FILE|OBJECT_DIRECTORY|ALTERNATE_OBJECT_DIRECTORIES|COMMON_DIR|NAMESPACE|TEMPLATE_DIR|EXEC_PATH|SSH|SSH_COMMAND|EXTERNAL_DIFF|DIFF_OPTS|PAGER|EDITOR|SEQUENCE_EDITOR|ASKPASS|PROXY_COMMAND|CONFIG|CONFIG_COUNT|CONFIG_KEY_[0-9]+|CONFIG_VALUE_[0-9]+|CONFIG_PARAMETERS)\\b",
      "reason": "Setting git environment variables that select the repository, configuration or programs to run is not allowed (they can bypass hooks or run commands)."
    },
    {
      "pattern": "(?<![\\w${])GIT_TRACE\\w*=(?!['\\\"]?(?:[0-9]|true|false|yes|no|on|off)['\\\"]?(?:[\\s;&|)]|$))",
      "reason": "Git trace variables pointing to a file write that file; use 1/true or a path set by a human."
    },
    {
      "pattern": "^(?=[\\s\\S]*\\bgit\\b)[\\s\\S]*(?:^|[\\s;&|(])(?:export\\s+)?(?:HOME|XDG_CONFIG_HOME)=",
      "reason": "Changing HOME or XDG_CONFIG_HOME in a git command line redirects git's global configuration (it can disable hooks)."
    },
    {
      "pattern": "\\brm(?=(?:\\s+(?:-[a-zA-Z]+|--[a-z-]+(?:=\\S*)?))*?\\s+(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(?:\\s|$))(?:\\s+(?:-[a-zA-Z]+|--[a-z-]+(?:=\\S*)?))*(?:\\s+--)?\\s+((?:/|~/?|\\$\\{?HOME\\}?/?|\\.{1,2}/?)\\*?|\\*)(\\s|$)",
      "reason": "Recursive delete of root, home, repository or wildcard."
    },
    {
      "pattern": "\\|\\s*(sudo\\s+)?(ba|z|da|k)?sh\\b",
      "reason": "Piping into a shell is not allowed."
    },
    {
      "pattern": "\\b(ba|z|da|k)?sh\\s+<\\(",
      "reason": "Executing process substitution in a shell is not allowed."
    },
    {
      "pattern": "(?:^|\\n)(?:(?!\\b(?:curl|wget)\\b)[^\\n])*\\b(curl|wget)\\b[^\\n]*?(&&|;)\\s*(sudo\\s+)?(ba|z|da|k)?sh\\b",
      "reason": "Downloading and executing scripts is not allowed."
    },
    {
      "pattern": "\\beval\\b",
      "reason": "eval is not allowed."
    },
    {
      "pattern": "(^|[\\s/=<>'\\\"])\\.env(\\.(?!example\\b)[\\w.-]+)?(\\s|$|['\\\"])",
      "reason": "Access to .env files is not allowed."
    },
    {
      "pattern": "(^|[\\s/=<>'\\\"])secrets/",
      "reason": "Access to secrets/ is not allowed."
    },
    {
      "pattern": "(^|[\\s;&|])(printenv|env)(\\s+(-0|--null))?\\s*($|[|>;&])",
      "reason": "Dumping environment variables may leak secrets."
    },
    {
      "pattern": "(^|[\\s;&|])(export\\s+-p|declare\\s+-p|compgen\\s+-v|set)\\s*($|[|>;&])",
      "reason": "Dumping shell variables may leak secrets."
    },
    {
      "pattern": "\\bgh\\s+(secret|auth\\s+token|repo\\s+delete|release\\s+delete|ruleset\\s+delete)\\b",
      "reason": "GitHub secrets and deletions require a human."
    },
    {
      "pattern": "\\bgh\\s+api\\b.*(-X|--method)\\s*DELETE\\b",
      "reason": "GitHub API deletions require a human."
    },
    {
      "pattern": "danger-full-access|dangerously-bypass",
      "reason": "Agent sandboxes must not be disabled."
    },
    {
      "pattern": "\\bchmod\\b(?=.*\\s(?:-[a-zA-Z]*R|--recursive\\b))(?=.*\\b0?[0-7]?777\\b|.*\\ba\\+rwx\\b)",
      "reason": "World-writable recursive permissions are not allowed."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:(?:^|[\\s/=<>'\"{,])\\.[eE](?:[*?\\[{]|[nN](?:[*?\\[{]|[vV][*?\\[{]))|(?:^|[\\s=<>'\"{,])\\.(?:\\[[^\\s'\\\"/\\]]{1,6}\\]|\\{|[*?]{1,3}[^\\s'\\\"/*?\\[{]{0,2}(?=[\\s'\";&|)/]|$)))",
      "reason": "Globs, brace or character-class expansion that can reach .env files is not allowed (fail closed; audit F-01)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:(?:^|[\\s/=<>'\"{,])\\.[eE][nN][vV](?:\\.(?![eE][xX][aA][mM][pP][lL][eE]\\b)[\\w.-]+)?(?:[\\s'\";&|),}<>\\]]|$))",
      "reason": "Access to .env files (also in upper case or in a brace list) is not allowed (audit F-01)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:(?:^|[\\s=<>'\"{,])(?:\\./)?[sS](?:[*?\\[{]|[eE](?:[*?\\[{]|[cC](?:[*?\\[{]|[rR](?:[*?\\[{]|[eE](?:[*?\\[{]|[tT](?:[*?\\[{]|[sS][*?\\[{]))))))[^\\s'\\\"]*/|/[sS][eE](?:[*?\\[{]|[cC](?:[*?\\[{]|[rR](?:[*?\\[{]|[eE](?:[*?\\[{]|[tT](?:[*?\\[{]|[sS][*?\\[{])))))[^\\s'\\\"]*/)",
      "reason": "Globs that can reach secrets/ are not allowed (fail closed; audit F-01)."
    },
    {
      "pattern": "(?:^|[\\s/=<>'\"{,])\\.(?:[eE](?:[nN][vV]?)?)?(?:\\$\\(|\\$\\{|\\$[A-Za-z_]|`)|(?:\\$\\(|\\$\\{|\\$[A-Za-z_]|`)[^)`]{0,200}\\.[eE][nN]?[vV]?[)`]|(?:^|[\\s/=<>'\"{,])[sS][eE][cC][rR]?(?:[eE](?:[tT][sS]?)?)?(?:\\$\\(|\\$\\{|\\$[A-Za-z_]|`)|(?:^|[\\s/=<>'\"{,])[sS][eE][cC][rR][eE][tT][sS][)`]",
      "reason": "Command substitution or variables that build .env or secrets names are not allowed (fail closed; audit F-01)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:(?:~|\\$\\{?HOME\\}?|/home/[^/\\s]+|/root|/Users/[^/\\s]+|[)}`])[\\\"']?/\\.(?:ssh|aws|gnupg|kube|azure|netrc|npmrc|pypirc|git-credentials|docker/config\\.json|config/(?:gh|gcloud))(?:[/\\s'\\\";&|)]|$)|(?:~|\\$\\{?HOME\\}?)[\\\"']?/\\.[^\\s/]*[*?\\[{])",
      "reason": "Reading credential stores in the home directory (.ssh, .aws, .gnupg, .kube, .azure, .netrc, .npmrc, .pypirc, .config/gh, .config/gcloud) is not allowed (audit F-01)."
    },
    {
      "pattern": "/proc/[^\\s/]+/(?:[eE][nN][vV][iI][rR][oO][nN]|[^\\s/]*[*?\\[{])",
      "reason": "Reading /proc/<pid>/environ dumps the environment and is not allowed (audit F-01)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:(?:^|[\\s/=<>'\"{,])[sS][eE][cC][rR][eE][tT][sS]/|\\b(?:tar|zip|7z|cp|mv|rsync|ln|scp|cat|head|tail|less|more|xxd|od|base64|strings|bat)\\b[^\\n;&|]{0,120}\\s(?:\\S{0,60}/)?[sS][eE][cC][rR][eE][tT][sS](?:[\\s'\\\";&|)]|$))",
      "reason": "Access to secrets/ (any case, also as a bare argument of copy, archive and read commands) is not allowed (audit F-01)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:\\bgh\\s+(?:-\\S+\\s+)*(?:pr\\s+merge|release\\s+(?:create|edit|upload)|workflow\\s+(?:run|enable|disable)|repo\\s+(?:edit|rename|archive|unarchive|transfer)|ruleset\\s+(?:create|edit|update))\\b)",
      "reason": "Merging, releasing, running workflows and changing repository settings require a human (audit F-02)."
    },
    {
      "pattern": "\\bgh\\s+(?:-\\S+\\s+)*pr\\s+review\\b.*\\s(?:--approve|-a)\\b",
      "reason": "Approving a pull request requires a human (audit F-02)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)(?=[\\s\\S]*\\bgh\\s+api\\b)(?=[\\s\\S]*(?:/merges?\\b|/rulesets?\\b|/protection\\b|/collaborators\\b|/hooks\\b|/keys\\b|/transfer\\b|/environments\\b|/visibility\\b|/dispatches\\b))(?=[\\s\\S]*(?:-X|--method)[ =]*[\\\"']?(?:[pP][uU][tT]|[pP][aA][tT][cC][hH]|[pP][oO][sS][tT]|[dD][eE][lL][eE][tT][eE])\\b)",
      "reason": "GitHub API calls with a writing method on merge, ref, content, ruleset, protection, secret, release, review or settings paths require a human (audit F-02, part 1)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)(?=[\\s\\S]*\\bgh\\s+api\\b)(?=[\\s\\S]*(?:/actions/(?:secrets|permissions|runners)|/actions/runs/[0-9]+/(?:rerun|cancel|approve)|/pulls/[0-9]+/reviews\\b|/releases\\b|/git/(?:refs|tags|commits)\\b|/contents/))(?=[\\s\\S]*(?:-X|--method)[ =]*[\\\"']?(?:[pP][uU][tT]|[pP][aA][tT][cC][hH]|[pP][oO][sS][tT]|[dD][eE][lL][eE][tT][eE])\\b)",
      "reason": "GitHub API calls with a writing method on merge, ref, content, ruleset, protection, secret, release, review or settings paths require a human (audit F-02, part 2)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)(?=[\\s\\S]*\\bgh\\s+api\\b)(?=[\\s\\S]*(?:/merges?\\b|/rulesets?\\b|/protection\\b|/collaborators\\b|/hooks\\b|/keys\\b|/transfer\\b|/environments\\b|/visibility\\b|/dispatches\\b))(?=[\\s\\S]*\\s(?:-[fF]|--(?:raw-)?field|--input)\\b)(?![\\s\\S]*\\bgh\\s+api\\b[^\\n;&|]*(?:-X|--method)[ =]*[\\\"']?[gG][eE][tT]\\b)",
      "reason": "GitHub API calls with request fields (an implicit POST) on those paths require a human (audit F-02, part 1)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)(?=[\\s\\S]*\\bgh\\s+api\\b)(?=[\\s\\S]*(?:/actions/(?:secrets|permissions|runners)|/actions/runs/[0-9]+/(?:rerun|cancel|approve)|/pulls/[0-9]+/reviews\\b|/releases\\b|/git/(?:refs|tags|commits)\\b|/contents/))(?=[\\s\\S]*\\s(?:-[fF]|--(?:raw-)?field|--input)\\b)(?![\\s\\S]*\\bgh\\s+api\\b[^\\n;&|]*(?:-X|--method)[ =]*[\\\"']?[gG][eE][tT]\\b)",
      "reason": "GitHub API calls with request fields (an implicit POST) on those paths require a human (audit F-02, part 2)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)(?=[\\s\\S]*\\bgh\\s+api\\s+graphql\\b)(?=[\\s\\S]*(?:\\bmutation\\b|query=@|--input))",
      "reason": "GitHub GraphQL mutations (merge, approve, settings) require a human (audit F-02)."
    },
    {
      "pattern": "^(?!\\s*(?:git\\s+commit|gh\\s+(?:pr|issue)\\s+\\w+)\\b(?![^\\n]*\\s-(?:F|f|-(?:file|body-file|template))\\b)(?=[^\\n;&|`$<>]*\\s-(?:m|b|t|-(?:message|body|title))\\b)[^\\n;&|`$<>]*$)[\\s\\S]*?(?:\\b(?:npm|pnpm|yarn)(?:\\s+(?:--?(?:otp|C|w|workspace|prefix|registry|tag|access|userconfig|cwd|dir|filter|F)[ =]\\S+|workspace\\s+\\S+|-\\S+|[a-z]+://\\S+|npm)){0,8}\\s+(?:publish|unpublish|deprecate|dist-tag|owner|token|login|adduser)\\b)",
      "reason": "Publishing and registry account changes require a human (audit F-02)."
    }
  ],
  "allowedDependencies": {
    "npm": [],
    "pypi": []
  },
  "taint": {
    "mode": "observe",
    "sources": {
      "tools": ["WebFetch", "WebSearch", "mcp__*"],
      "bashNetwork": true,
      "readOutsideProject": true
    },
    "restrictTools": ["WebFetch", "WebSearch", "mcp__*"]
  }
}
