{
  "block": [
    "cat .env*",
    "cat .en[v]",
    "cat .e*",
    "head -n1 .en?",
    "cat $(echo .en)v",
    "cat `echo .en`v",
    "cat s*/x",
    "cat se?rets/key",
    "cat sec[r]ets/key",
    "cat ./s*/k",
    "cat config/se*/k",
    "cat .ENV",
    "cat .Env",
    "cat {.env,x}",
    "cat .[e]nv",
    "cat .?nv",
    "cat .*v",
    "cat .{e,x}nv",
    "cat .$(echo env)",
    "cat .e$X",
    "cat .env$X",
    "cat \"$(pwd)\"/.en$(echo v)",
    "cat $(echo .env)",
    "cat $(echo secrets)/k",
    "cat sec$X/k",
    "cat ~/.ssh/id_ed25519",
    "cat $HOME/.aws/credentials",
    "cat ${HOME}/.aws/credentials",
    "cat ~/.config/gh/hosts.yml",
    "cat /home/user/.ssh/id_rsa",
    "cat /root/.gnupg/secring.gpg",
    "tar c ~/.aws",
    "ls ~/.s*",
    "cat ~/.ss[h]/id_rsa",
    "cat $(echo ~)/.ssh/id_rsa",
    "cat /proc/self/environ",
    "cat /proc/1234/environ",
    "strings /proc/self/environ",
    "cat /proc/*/environ",
    "cat /proc/self/e*",
    "gh pr merge 5 --squash",
    "gh pr merge 5 --admin",
    "gh api -X PUT repos/o/r/pulls/1/merge",
    "gh api --method put repos/o/r/pulls/1/merge",
    "gh api --method=PATCH repos/o/r/rulesets/1 -f enforcement=disabled",
    "gh api repos/o/r/rulesets/1 -f enforcement=disabled",
    "gh api -X POST repos/o/r/rulesets --input r.json",
    "gh api -X DELETE repos/o/r/branches/main/protection",
    "gh api repos/o/r/actions/secrets/X -X PUT -f x=y",
    "gh api graphql -f query='mutation{mergePullRequest(input:{pullRequestId:\"x\"}){clientMutationId}}'",
    "gh api graphql -F query=@merge.graphql",
    "gh pr review 5 --approve",
    "gh pr review 5 -a",
    "gh release create v1",
    "gh workflow run ci.yml",
    "gh repo edit --visibility public",
    "npm publish",
    "pnpm publish --tag x",
    "yarn npm publish",
    "npm --registry https://r.example publish",
    "npm dist-tag add x@1 latest",
    "gh api -X GET -X PUT repos/o/r/pulls/1/merge",
    "gh api repos/o/r/rulesets/1 -f enforcement=disabled; echo -X GET",
    "gh api --method GET --method PATCH repos/o/r/rulesets/1",
    "gh api -X PUT repos/o/r/pulls/1/merges",
    "gh api -X POST repos/o/r/git/refs -f ref=refs/heads/x",
    "gh api -X PUT repos/o/r/contents/README.md -f message=x",
    "gh api -X POST repos/o/r/actions/runs/123/rerun",
    "cat \"$HOME\"/.ssh/id_rsa",
    "cat ~/.npmrc",
    "cat ~/.pypirc",
    "cat .env>/tmp/x",
    "cat .env<x",
    "cat SECRETS/key",
    "tar c secrets",
    "zip -r out.zip secrets",
    "cp -r secrets /tmp/x",
    "npm --otp 123456 publish",
    "pnpm -C dir publish",
    "npm -w pkg publish",
    "yarn workspace pkg npm publish",
    "gh api graphql -f query='mu''tation{mergePullRequest(input:{})}'",
    "git commit -m 'x' && cat .env*",
    "gh pr create --body 'x'; cat .e*",
    "gh pr create --body-file .e*"
  ],
  "allow": [
    "cat .env.example",
    "cat README.md",
    "ls src/s*/",
    "cat .gitignore",
    "ls .github",
    "cat ./.eslintrc.json",
    "cat .eslintrc*",
    "cat .editorconfig",
    "ls ~",
    "cat ~/notes.txt",
    "cat /proc/cpuinfo",
    "cat /proc/self/status",
    "echo $(git rev-parse --show-toplevel)/README.md",
    "git add src/*.ts",
    "find . -name '*.ts'",
    "grep -rn \".*Error\" src",
    "grep -E '(.*)' f.txt",
    "grep -r \"secrets\" docs",
    "sed 's/.*foo//' f.txt",
    "git commit -m 'docs: environment and secrets handling'",
    "cat docs/secretsmanager.md",
    "gh pr view 5",
    "gh pr checks 5",
    "gh pr create --title x --body y",
    "gh issue comment 3 --body x",
    "gh api repos/o/r/pulls",
    "gh api -X GET repos/o/r/rulesets",
    "gh api repos/o/r/rulesets",
    "gh api repos/o/r/issues/3/comments -f body=x",
    "gh run list",
    "gh workflow list",
    "gh release list",
    "gh api graphql -f query='query{viewer{login}}'",
    "npm install",
    "npm ci",
    "npm test",
    "npm run build",
    "npm view zod version",
    "pip install -r requirements.txt",
    "grep '.*foo' file.txt",
    "git commit -m 'fix: handle .env* globs and ~/.ssh paths'",
    "gh pr create --title 'docs: .env* globs' --body 'mentions ~/.aws and gh pr merge and npm publish'",
    "gh issue comment 3 --body 'cat .env* is blocked, gh api -X PUT /merge too'",
    "gh pr review 5 --comment --body 'see ~/.ssh note'"
  ]
}
