{
  "_comment": "Command rule against running commands with elevated privileges (sudo, sudoedit, doas, pkexec). Shared by the plugin (Vitest) and the Python port of the repository hook; both must decide identically. Only fed into the check, never executed. Both rules of the patch (command position, and wrappers with option values) together; known forms, see README.",
  "block": [
    "sudo ls",
    "sudo -n true",
    "sudo -u root npm i zod",
    "sudo bash -c 'echo 127.0.0.1 example.test >> /etc/hosts'",
    "doas ls",
    "doas -u root ls",
    "pkexec ls",
    "sudoedit /etc/hosts",
    "/usr/bin/sudo ls",
    "\\sudo ls",
    "s''udo ls",
    "\"sudo\" ls",
    "  sudo ls",
    "SUDO_ASKPASS=/bin/x sudo -A ls",
    "env sudo ls",
    "env -i PATH=/usr/bin sudo ls",
    "nohup sudo ls",
    "nice -n 10 sudo ls",
    "timeout 5 sudo ls",
    "time sudo ls",
    "command sudo ls",
    "exec sudo ls",
    "setsid sudo ls",
    "busybox sudo ls",
    "xargs sudo rm",
    "xargs -0 sudo rm",
    "find . -name x -exec sudo rm {} \\;",
    "watch -n 5 sudo ls",
    "ls; sudo ls",
    "ls && sudo ls",
    "ls || doas ls",
    "ls | sudo tee /etc/x",
    "ls & sudo ls",
    "(sudo ls)",
    "{ sudo ls; }",
    "! sudo ls",
    "echo $(sudo cat /etc/shadow)",
    "echo `sudo ls`",
    "if sudo -n true; then echo ok; fi",
    "while sudo ls; do break; done",
    "for x in a; do sudo ls; done",
    "bash -c 'sudo ls'",
    "sh -c \"doas ls\"",
    "bash -lc 'pkexec ls'",
    "zsh -c 'sudo ls'",
    "csh -c 'sudo ls'",
    "su -c 'sudo ls'",
    "su - root -c 'sudo ls'",
    "ls\nsudo ls",
    "env -u HOME sudo ls",
    "env -uHOME sudo ls",
    "env -i -u X PATH=/x sudo ls",
    "env -S 'sudo ls'",
    "/usr/bin/env -u X sudo ls",
    "timeout -s KILL 5 sudo ls",
    "timeout -k 1 5 sudo ls",
    "timeout --foreground 5 doas ls",
    "xargs -I {} sudo rm {}",
    "xargs -I{} sudo rm {}",
    "xargs -n 1 sudo rm",
    "xargs -0 -n 1 pkexec rm",
    "ls | xargs -I {} sudo cp {} /x",
    "flock /tmp/l sudo ls",
    "flock -w 5 /tmp/l sudo ls",
    "flock -n /tmp/l doas ls",
    "exec -a name sudo ls",
    "nice -n10 sudo ls",
    "ionice -c 3 sudo ls"
  ],
  "allow": [
    "ls",
    "echo sudo",
    "man sudo",
    "which sudo",
    "type sudo",
    "command -v sudo",
    "command -V doas",
    "apt-cache show sudo",
    "grep -rn sudo src",
    "grep -c sudo README.md",
    "grep -rn \"sudo\" src",
    "cat /etc/sudoers.d/README",
    "ls /usr/bin/sudo",
    "ls -l /usr/bin/pkexec",
    "git commit -m 'docs: explain sudo'",
    "git log --grep sudo",
    "echo pseudo",
    "echo sudoku",
    "npm view sudo-prompt",
    "su -c 'ls'",
    "su - root",
    "bash -c 'echo sudo'",
    "xargs -0 grep sudo",
    "xargs -n 1 grep sudo",
    "env -u X grep sudo f",
    "env FOO=sudo ls",
    "timeout -s KILL 5 grep 'sudo' f",
    "timeout 5 grep -c sudo f",
    "flock /tmp/l grep sudo f",
    "flock -n /tmp/l echo \"sudo\"",
    "exec -a name grep sudo",
    "nice -n 10 grep sudo f"
  ]
}
