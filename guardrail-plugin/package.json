{
  "name": "@tollwire/guardrail-plugin",
  "version": "0.1.2",
  "description": "Guardrail plugin for coding agents: enforces protected paths, blocked commands and a dependency allowlist via hooks and MCP.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TollWire/tollwire.git",
    "directory": "guardrail-plugin"
  },
  "homepage": "https://github.com/TollWire/tollwire/tree/main/guardrail-plugin#readme",
  "bugs": {
    "url": "https://github.com/TollWire/tollwire/issues"
  },
  "author": {
    "name": "TollWire",
    "url": "https://github.com/TollWire"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "tollgate-events": "dist/events/verifyBin.js",
    "tollgate-guard": "dist/hookCli.js",
    "tollgate-guardrail-mcp": "dist/mcp/server.js",
    "tollgate-taint": "dist/taintCli.js"
  },
  "files": [
    "dist/",
    ".claude-plugin/",
    ".mcp.json",
    "hooks/",
    "policy/",
    "docs/",
    "npm-shrinkwrap.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs && node scripts/sdkCompat.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
